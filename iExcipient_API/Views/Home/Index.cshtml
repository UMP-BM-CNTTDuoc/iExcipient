@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Trang chủ";
}

<link href="~/Content/Home.css" rel="stylesheet" />

<div class="hero-section">
    <h1>TRA CỨU THÀNH PHẦN CÔNG THỨC TRONG DƯỢC MỸ PHẨM</h1>
    <p>
        Nền tảng tích hợp toàn diện dữ liệu thành phần mỹ phẩm (CosIng) và tá dược chuyên sâu (HOPE).
        Hỗ trợ tra cứu thông số lý hóa, cập nhật quy định pháp lý và hỗ trợ định hình công thức bào chế hiện đại.
    </p>
</div>

<!-- Stats Counters -->
<div class="stats-grid">
    <a href="@Url.Action("Index", "Hope")" class="stat-card">
        <div class="stat-icon"><i class="fa-solid fa-mortar-pestle"></i></div>
        <div class="stat-number">@(((long)ViewBag.CountHope).ToString("#,##0", new System.Globalization.CultureInfo("vi-VN")))</div>
        <div class="stat-label">chuyên luận HOPE</div>
    </a>
    <a href="@Url.Action("Index", "Cosing")" class="stat-card">
        <div class="stat-icon"><i class="fa-solid fa-pump-soap"></i></div>
        <div class="stat-number">@ViewBag.CountCosing</div>
        <div class="stat-label">thành phần CosIng</div>
    </a>
    <div class="stat-card">
        <div class="stat-icon" style="color: var(--accent-yellow);"><i class="fa-solid fa-shield-heart"></i></div>
        <div class="stat-number">@ViewBag.CountEwg</div>
        <div class="stat-label">chất điểm an toàn EWG</div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="color: var(--accent-red);"><i class="fa-solid fa-scale-balanced"></i></div>
        <div class="stat-number">@ViewBag.CountAnnex</div>
        <div class="stat-label">chất quy định Annex EU</div>
    </div>
</div>

<!-- Search Inputs Section -->
<div class="search-sections">
    <div class="quick-search-box">
        <div>
            <h3><i class="fa-solid fa-pump-soap" style="color: var(--btn-green);"></i> Tra cứu CosIng (Mỹ phẩm)</h3>
            <p>Tìm kiếm nhanh các thành phần mỹ phẩm theo tên INCI hoặc mã CAS/EC để kiểm tra quy định an toàn của Liên minh Châu Âu (EU).</p>
        </div>
        <form action="@Url.Action("Index", "Cosing")" method="get" class="quick-search-form">
            <input type="text" name="q" placeholder="Nhập tên INCI, mã CAS..." required>
            <button type="submit"><i class="fa-solid fa-magnifying-glass"></i> Tìm</button>
        </form>
    </div>

    <div class="quick-search-box">
        <div>
            <h3><i class="fa-solid fa-mortar-pestle" style="color: var(--btn-green);"></i> Tra cứu HOPE (Tá dược dược phẩm)</h3>
            <p>Tìm kiếm các tá dược chuyên sâu theo tên INN, IUPAC, CAS. Kiểm tra chi tiết tính chất vật lý, độ an toàn EWG và tương kỵ bào chế.</p>
        </div>
        <form action="@Url.Action("Index", "Hope")" method="get" class="quick-search-form">
            <input type="text" name="q" placeholder="Nhập tên INN, CAS..." required>
            <button type="submit"><i class="fa-solid fa-magnifying-glass"></i> Tìm</button>
        </form>
    </div>
</div>

<!-- Comparison Table -->
<div class="table-section">
    <h2>So sánh hai hệ thống dữ liệu</h2>
    <table class="compare-table">
        <thead>
            <tr>
                <th>Tiêu chí so sánh</th>
                <th>Phân hệ CosIng (Mỹ phẩm)</th>
                <th>Phân hệ HOPE (Tá dược Dược phẩm)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Đối tượng tra cứu</td>
                <td>Dành cho thành phần, nguyên liệu sản xuất mỹ phẩm theo cơ sở dữ liệu chính thức của EU.</td>
                <td>Dành cho các tá dược y tế chính thức trong cẩm nang tá dược quốc tế (Handbook of Pharmaceutical Excipients).</td>
            </tr>
            <tr>
                <td>Thông tin cốt lõi</td>
                <td>Tên danh pháp mỹ phẩm INCI, số CAS, số EC, phân loại chức năng mỹ phẩm và cảnh báo hạn chế pháp lý.</td>
                <td>Tên danh pháp quốc tế INN, IUPAC, tên khác, công thức hóa học, khối lượng, mô tả lý hóa, tương kỵ và liên kết cấu trúc PubChem.</td>
            </tr>
            <tr>
                <td>Bản chất an toàn</td>
                <td>Ràng buộc về mặt pháp luật và quy chuẩn phân phối mỹ phẩm tại Châu Âu.</td>
                <td>Đánh giá an toàn thực nghiệm theo thang điểm EWG Skin Deep (Hazard rating 1-10) và lưu ý tính tương kỵ hóa học.</td>
            </tr>
            <tr>
                <td>Quy định Annex pháp lý</td>
                <td>Tích hợp trực tiếp các phụ lục cấm (Annex II), hạn chế (Annex III), chất tạo màu (Annex IV), chất bảo quản (Annex V), lọc UV (Annex VI).</td>
                <td>Có đối chiếu chéo sang quy định Annex EU để kiểm tra mức độ cảnh báo giới hạn của chất.</td>
            </tr>
            <tr>
                <td>Tính liên kết chéo</td>
                <td>Cho phép đối chiếu và chuyển hướng sang chuyên luận tá dược dược phẩm HOPE tương đương nếu có liên kết.</td>
                <td>Cho phép đối chiếu ngược lại danh mục nguyên liệu CosIng để xem chức năng mỹ phẩm của tá dược đó.</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- FUNCTION TABLE -->
<div class="table-section">
    <h2>Mô tả chi tiết chức năng</h2>
    <div class="function-switch">
        <button id="btnCosing" class="active" onclick="switchFunctionTable('hope')">
            Tra cứu trong CosIng
        </button>
        <button id="btnHope" onclick="switchFunctionTable('cosing')">
            Tra cứu trong sách HOPE
        </button>
    </div>
    <div class="function-table-wrapper">
        <div class="function-table-scroll">
            <table class="compare-table" id="functionTable">
                <thead>
                    <tr>
                        <th style="width:35%">Tên chức năng</th>
                        <th>Mô tả chức năng</th>
                    </tr>
                </thead>
                <tbody id="functionTableBody">
                    <!-- Render bằng JS -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- User Manual Section -->
<div class="manual-section" id="huong-dan">
    <div class="manual-container">
        <h2>Hướng dẫn sử dụng hệ thống</h2>
        
        <div class="manual-step">
            <div class="manual-step-num">1</div>
            <div class="manual-step-content">
                <h3>Lựa chọn phân hệ phù hợp</h3>
                <p>
                    Sử dụng thanh điều hướng chính ở đầu trang để chuyển đổi giữa hai tab <strong>CosIng</strong> (nghiên cứu thành phần mỹ phẩm) 
                    hoặc <strong>HOPE</strong> (nghiên cứu các tá dược phổ biến trong bào chế dược phẩm).
                </p>
            </div>
        </div>

        <div class="manual-step">
            <div class="manual-step-num">2</div>
            <div class="manual-step-content">
                <h3>Tìm kiếm & Lọc nâng cao</h3>
                <p>
                    Nhập từ khóa (tên chất, mã CAS) vào ô tìm kiếm. Sử dụng bảng bộ lọc bên trái để lọc danh sách kết quả 
                    theo nhóm chức năng mong muốn, khoảng điểm an toàn EWG hoặc nhóm quy định pháp lý Annex giới hạn của Châu Âu.
                </p>
            </div>
        </div>

        <div class="manual-step">
            <div class="manual-step-num">3</div>
            <div class="manual-step-content">
                <h3>Xem chuyên luận & Xuất PDF</h3>
                <p>
                    Click vào tên chất trong danh sách kết quả để xem toàn bộ thông tin chi tiết. 
                    Bạn có thể tải tài liệu chuyên luận này về máy dưới dạng tệp PDF bằng cách nhấn nút <strong>Xuất PDF / Tải PDF</strong> trên trang chi tiết chất.
                </p>
            </div>
        </div>
    </div>
</div>

<script>
    const cosingFunctions = [
        {
            name: "Tác nhân kiềm hóa",
            desc: "Chất được thêm vào để làm hệ thống có tính kiềm hơn, làm tăng giá trị pH"
        },
        {
            name: "Tác nhân acid hóa",
            desc: "Chất được thêm vào để làm hệ thống có tính acid hơn, làm giảm giá trị pH"
        },
        {
            name: "Chất hấp phụ",
            desc: "Chất được dùng để liên kết với một thành phần khác trong công thức, đóng vai trò là chất mang, kho dự trữ hoặc chất cô lập"
        },
        {
            name: "Khí đẩy bình xịt",
            desc: "Chất cung cấp năng lượng trong công thức để tạo ra khí dùng khi kích hoạt van"
        },
        {
            name: "Tác nhân đẩy/thay thế không khí",
            desc: "Chất được dùng để thay thế không khí trong sản phẩm hoặc bao bì bằng khí có thành phần đã biết"
        },
        {
            name: "Chất biến tính cồn",
            desc: "Chất được thêm vào để làm cho cồn không thể uống được"
        }
    ];

    const hopeFunctions = [
        {
            name: "Tá dược độn",
            desc: "Tá dược dùng để tăng khối lượng hoặc thể tích chế phẩm thuốc"
        },
        {
            name: "Tá dược dính",
            desc: "Tá dược giúp liên kết các tiểu phân bột trong quá trình tạo hạt hoặc dập viên"
        },
        {
            name: "Tá dược rã",
            desc: "Tá dược hỗ trợ viên thuốc phân rã nhanh sau khi sử dụng"
        },
        {
            name: "Tá dược trơn",
            desc: "Tá dược làm giảm ma sát trong quá trình sản xuất viên nén hoặc nang"
        },
        {
            name: "Chất bảo quản",
            desc: "Chất giúp hạn chế sự phát triển của vi sinh vật trong chế phẩm"
        },
        {
            name: "Chất diện hoạt",
            desc: "Chất làm giảm sức căng bề mặt và hỗ trợ hòa tan hoặc nhũ hóa"
        }
    ];

    function renderFunctionTable(data) {
        const tbody = document.getElementById("functionTableBody");

        tbody.innerHTML = data.map((item, index) => `
            <tr style="background:${index % 2 === 0 ? '#fff' : '#f9fafb'}">
                <td style="padding:10px 14px;border-bottom:1px solid #f0f0f0;font-weight:500">
                    ${item.name}
        </td>
        <td style="padding:10px 14px;border-bottom:1px solid #f0f0f0;color:#444;line-height:1.6">
            ${item.desc}
        </td>
    </tr>
        `).join('');
    }

    function switchFunctionTable(type) {

        const btnCosing = document.getElementById("btnCosing");
        const btnHope = document.getElementById("btnHope");

        btnCosing.classList.remove("active");
        btnHope.classList.remove("active");

        if (type === "cosing") {
            btnCosing.classList.add("active");
            renderFunctionTable(cosingFunctions);
        }
        else {
            btnHope.classList.add("active");
            renderFunctionTable(hopeFunctions);
        }
    }

    // Init
    renderFunctionTable(cosingFunctions);
</script>